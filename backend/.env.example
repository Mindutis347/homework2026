# Backend configuration. Copy to .env and fill in — .env is gitignored.
# On Render these come from the service's environment variables instead.

# Neon pooled connection string (add ?sslmode=require)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# HMAC key for session JWTs and verification codes. 32+ random chars.
JWT_SECRET=change-me-to-a-long-random-string

PORT=8080

# Local dev runs over http, so cookies must not be Secure.
# In production set TRUE (Render) or the cookie will be dropped.
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins (Vercel URL in production).
CORS_ORIGINS=http://localhost:5173

# Load the demo catalog when the products table is empty.
SEED_ON_BOOT=true

# Expose verification codes in API responses + /api/dev/inbox (no SMTP in demo).
SHOW_DEV_CODES=true
